{
  "name": "talk-desktop",
  "version": "2.2.1",
  "private": true,
  "bugs": {
    "url": "https://github.com/nextcloud/talk-desktop/issues",
    "create": "https://github.com/nextcloud/talk-desktop/issues/new/choose"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextcloud/talk-desktop"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Grigorii K. Shartsev",
    "email": "me@shgk.me"
  },
  "main": "./.webpack/main",
  "scripts": {
    "build": "electron-forge package",
    "build:linux": "electron-forge package --platform=linux",
    "build:mac": "electron-forge package --platform=darwin --arch=universal",
    "build:mac:arm64": "electron-forge package --platform=darwin --arch=arm64",
    "build:mac:x64": "electron-forge package --platform=darwin --arch=x64",
    "build:windows": "electron-forge package --platform=win32",
    "build:windows:arm64": "electron-forge package --platform=win32 --arch=arm64",
    "build:windows:x64": "electron-forge package --platform=win32 --arch=x64",
    "dev": "electron-forge start",
    "download-vue-devtools": "node ./scripts/download-vue-devtools.mjs",
    "generate-icons": "node ./scripts/generate-icons.js",
    "lint": "eslint --fix",
    "package": "electron-forge make --skip-package",
    "package:linux": "electron-forge make --skip-package --platform=linux",
    "package:mac": "electron-forge make --skip-package --platform=darwin --arch=universal",
    "package:mac:arm64": "electron-forge make --skip-package --platform=darwin --arch=arm64",
    "package:mac:x64": "electron-forge make --skip-package --platform=darwin --arch=x64",
    "package:windows": "electron-forge make --skip-package --platform=win32",
    "package:windows:arm64": "electron-forge make --skip-package --platform=win32 --arch=arm64",
    "package:windows:arm64:exe": "electron-forge make --skip-package --platform=win32 --arch=arm64 --targets=squirrel",
    "package:windows:arm64:msi": "electron-forge make --skip-package --platform=win32 --arch=arm64 --targets=wix",
    "package:windows:x64": "electron-forge make --skip-package --platform=win32 --arch=x64",
    "package:windows:x64:exe": "electron-forge make --skip-package --platform=win32 --arch=x64 --targets=squirrel",
    "package:windows:x64:msi": "electron-forge make --skip-package --platform=win32 --arch=x64 --targets=wix",
    "release:package": "npx -y zx ./scripts/prepare-release-packages.mjs",
    "start": "npm run dev",
    "ts:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@mdi/svg": "^7.4.47",
    "@nextcloud/auth": "^2.5.3",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/browser-storage": "^0.5.0",
    "@nextcloud/event-bus": "^3.3.2",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/notify_push": "^1.4.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.8.2",
    "@vueuse/core": "^14.3.0",
    "core-js": "^3.49.0",
    "electron-squirrel-startup": "^1.0.1",
    "howler": "^2.2.4",
    "mri": "^1.2.0",
    "pinia": "^3.0.4",
    "semver": "^7.8.5",
    "unzip-crx-3": "^0.2.0",
    "vue": "^3.5.39",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^5.1.0",
    "webdav": "^5.10.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-flatpak": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-wix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron/node-gyp": "github:electron/node-gyp#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/howler": "^2.2.13",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "@vue/tsconfig": "^0.9.1",
    "cheerio": "^1.2.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "electron": "^41.2.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "icon-gen": "^5.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "node-loader": "^2.1.0",
    "node-polyfill-webpack-plugin": "4.0.0",
    "sass": "^1.101.0",
    "sass-loader": "^17.0.0",
    "typescript": "^6.0.3",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.6",
    "webpack": "^5.108.3",
    "webpack-merge": "^6.0.1",
    "worker-loader": "^3.0.8",
    "zx": "^8.8.5"
  },
  "optionalDependencies": {
    "@vscode/windows-registry": "github:nextcloud-deps/vscode-windows-registry#v1.2.0-prebuild"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "allowScripts": {
    "github:nextcloud-deps/vscode-windows-registry": true,
    "core-js": true,
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "sharp": true
  },
  "desktopName": "com.nextcloud.talk.desktop",
  "productName": "Nextcloud Talk",
  "talk": {
    "stable": "v24.0.2",
    "beta": "v24.0.2",
    "dev": "main"
  }
}
