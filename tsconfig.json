{
	"extends": "@vue/tsconfig/tsconfig.json",
	"include": ["src/**/*.ts", "src/**/*.vue", "build/BuildConfig.types.ts"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"checkJs": false,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strictNullChecks": true,
		"paths": {
			"@global-styles/*": ["./resources/server-global-styles/master/*"],
			// Dirty workaround to prevent TS from type checking Talk source files
			// Making it a .js file allows skipping it by enabled skipLibCheck (in @vue/tsconfig/tsconfig.json)
			"@nextcloud/talk/*.ts": ["./node_modules/@nextcloud/talk/src/main.js"],
		},
	},
}
